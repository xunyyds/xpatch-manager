<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+ 的备份 / 换机迁移规则。

    必须排除的三项（任一进了云备份都是实质泄露或行为漂移）：
      1) sharedpref/signatures.xml   自定义签名档的档案元数据（含 PKCS12 密码明文）
      2) file/signatures/            自定义签名档的 PKCS12 私钥文件（SignatureStore.addCustom）
      3) sharedpref/module_guard.xml 模块熔断事件（会被首页横幅当成"已自动移除"的可信结论展示，
                                     从别的设备恢复过来等于伪造一次崩溃处置）

    只做排除、不做 include：其余设置（主题、作用域、打包历史）仍按系统默认参与备份。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="signatures.xml" />
        <exclude domain="sharedpref" path="module_guard.xml" />
        <exclude domain="file" path="signatures/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="signatures.xml" />
        <exclude domain="sharedpref" path="module_guard.xml" />
        <exclude domain="file" path="signatures/" />
    </device-transfer>
</data-extraction-rules>
