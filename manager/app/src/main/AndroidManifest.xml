<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
        模块熔断广播（io.xpatch.action.MODULE_CRASH）的发送方门禁。
        该广播由被注入的目标应用进程（内核 XpInit.notifyModuleCrash）发出，无法改成 exported="false"，
        因此用 signature 级自定义权限把关：只有与本管理器同证书的应用才可能持有它。
        注意：protectionLevel="signature" 意味着"被重签的应用必须与管理器同证书"才发得进来——
        默认签名档（XPatch 内置证书）满足；用户自选其它证书档不满足，熔断会退化为只有日志。
    -->
    <permission
        android:name="io.xpatch.permission.MODULE_CRASH"
        android:protectionLevel="signature" />

    <!--
        内核侧用 sendBroadcast(intent, "io.xpatch.permission.MODULE_CRASH") 发送，
        该重载要求"接收方也持有此权限"，所以管理器自己必须先声明使用它（同证书自动授予）。
    -->
    <uses-permission android:name="io.xpatch.permission.MODULE_CRASH" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.XPatch">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.XPatch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name="io.xpatch.patch.InstallReceiver"
            android:exported="false" />
        <receiver
            android:name="io.xpatch.notify.NotificationActionReceiver"
            android:exported="false" />
        <receiver
            android:name="io.xpatch.notify.ModuleCrashReceiver"
            android:exported="true"
            android:permission="io.xpatch.permission.MODULE_CRASH">
            <intent-filter>
                <action android:name="io.xpatch.action.MODULE_CRASH" />
            </intent-filter>
        </receiver>
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="io.xpatch.provider.FrameworkBridgeProvider"
            android:authorities="io.xpatch.FrameworkBridge"
            android:exported="true"
            android:multiprocess="false"
            android:grantUriPermissions="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="io.xpatch.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

